# Storefront environment. Copy to .env.local for local overrides, and set the same
# variables in your host's dashboard (Vercel/Netlify) for production.
#
# Vite only exposes variables prefixed with VITE_ to the browser. Never put a secret
# here — everything in this file is readable by anyone who opens the site.

# Origin of the API, with no trailing slash and no /api suffix.
# Leave BLANK in local development: the Vite dev server proxies /api to
# http://localhost:5000 for you (see vite.config.ts).
# In production this is required, e.g. https://mosas-api.onrender.com
VITE_API_URL=

# The shop's phone number in full international form, e.g. +2348012345678.
# The footer prints it and the floating WhatsApp button dials it; both hide
# themselves while it is blank, so the site never shows a number that isn't yours.
VITE_STORE_PHONE=
